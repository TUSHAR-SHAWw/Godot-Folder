; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Platform Royale"
config/description="A 2D Vertical Battle Royale inspired by The Platform."
run/main_scene="res://ui/menus/MainMenu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[autoload]

SignalBus="*res://utils/SignalBus.gd"
GameManager="*res://autoload/GameManager.gd"
RoundManager="*res://autoload/RoundManager.gd"
FloorManager="*res://autoload/FloorManager.gd"
LootManager="*res://autoload/LootManager.gd"
ItemDatabase="*res://autoload/ItemDatabase.gd"
CombatRules="*res://autoload/CombatRules.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Players"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Projectiles"
2d_physics/layer_5="Hazards"
2d_physics/layer_6="Interactables"
